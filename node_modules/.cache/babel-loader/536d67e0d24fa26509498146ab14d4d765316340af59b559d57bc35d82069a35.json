back\">No Image</div>\n        ) : (\n          <img src={product.image} alt={product.title} onError={() => setImageError(true)} />\n        )}\n        <span className=\"category\">{product.category}</span>\n      </div>\n\n      <div className=\"product-info\">\n        <div className=\"product-title-row\">\n          <h3>{product.title}</h3>\n          <button\n            className=\"delete-button\"\n            type=\"button\"\n            onClick={() => onDelete(product.id)}\n            aria-label={`Delete ${product.title}`}\n            title=\"Delete product\"\n          >\n            🗑\n          </button>\n        </div>\n\n        <p>{product.description}</p>\n\n        <div className=\"product-bottom\">\n          <strong>${product.price}</strong>\n          <span className=\"details-label\">Product</span>\n        </div>\n      </div>\n    </article>\n  );\n}\n\nexport default ProductCard;\n"],"mappings":"AAAA,OAASA,QAAQ,KAAQ,OAAO,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAEjC,QAAS,CAAAC,WAAWA,CAAAC,IAAA,CAAwB,IAAvB,CAAEC,OAAO,CAAEC,QAAS,CAAC,CAAAF,IAAA,CACxC,KAAM,CAACG,UAAU,CAAEC,aAAa,CAAC,CAAGV,QAAQ,CAAC,KAAK,CAAC,CAEnD,mBACEI,KAAA,YAASO,SAAS,CAAC,cAAc,CAAAC,QAAA,eAC/BR,KAAA,QAAKO,SAAS,CAAC,eAAe,CAAAC,QAAA,EAC3BH,UAAU,cACTP,IAAA,QAAKS,SAAS,CAAC,gBAAgB,CAAAC,QAAA,CAAC,UAAQ,CAAK,CAAC,cAE9CV,IAAA,QAAKW,GAAG,CAAEN,OAAO,CAACO,KAAM,CAACC,GAAG,CAAER,OAAO,CAACS,KAAM,CAACC,OAAO,CAAEA,CAAA,GAAMP,aAAa,CAAC,IAAI,CAAE,CAAE,CACnF,cACDR,IAAA,SAAMS,SAAS,CAAC,UAAU,CAAAC,QAAA,CAAEL,OAAO,CAACW,QAAQ,CAAO,CAAC,EACjD,CAAC,cAENd,KAAA,QAAKO,SAAS,CAAC,cAAc,CAAAC,QAAA,eAC3BR,KAAA,QAAKO,SAAS,CAAC,mBAAmB,CAAAC,QAAA,eAChCV,IAAA,OAAAU,QAAA,CAAKL,OAAO,CAACS,KAAK,CAAK,CAAC,cACxBd,IAAA,WACES,SAAS,CAAC,eAAe,CACzBQ,IAAI,CAAC,QAAQ,CACbC,OAAO,CAAEA,CAAA,GAAMZ,QAAQ,CAACD,OAAO,CAACc,EAAE,CAAE,CACpC,aAAY,UAAUd,OAAO,CAACS,KAAK,EAAG,CACtCA,KAAK,CAAC,gBAAgB,CAAAJ,QAAA,CACvB,cAED,CAAQ,CAAC,EACN,CAAC,cAENV,IAAA,MAAAU,QAAA,CAAIL,OAAO,CAACe,WAAW,CAAI,CAAC,cAE5BlB,KAAA,QAAKO,SAAS,CAAC,gB